{
  "name": "verse-onchain",
  "version": "0.0.1",
  "description": "Download Verse on-chain projects to your computer",
  "main": "index.js",
  "scripts": {
    "start": "node dist/cli/index.js",
    "gen-contract": "typechain --target ethers-v5 --out-dir ./generated/contracts ./abi/**/*.json",
    "gen-proto": "pbjs --ts ./generated/pb/payload.ts ./docs/payload.proto",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:web": "tsc -p tsconfig.web.json",
    "build": "yarn gen-contract && yarn gen-proto && yarn build:cli && yarn build:web",
    "run:cli": "node dist/cli/src/cli/index.js",
    "dev:web": "vite"
  },
  "author": "Verse Works",
  "website": "https://verse.works",
  "license": "MIT",
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^20.11.19",
    "@types/pako": "^2.0.3",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "framer-motion": "^11.0.3",
    "pako": "^2.1.0",
    "pbjs": "^0.0.14",
    "protobufjs": "^7.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "table": "^6.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.1",
    "typescript": "^5.3.3",
    "viem": "^2.7.9"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "protoc-gen-ts_proto": "^1.180.0",
    "vite": "^5.1.0"
  }
}
